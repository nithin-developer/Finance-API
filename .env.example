APP_NAME=Finance Dashboard API
ENVIRONMENT=development

SECRET_KEY=change-this-to-a-strong-random-secret
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finance_db

ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

FIRST_ADMIN_NAME=System Admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin@12345
AUTO_CREATE_TABLES=true

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/health,/docs,/redoc,/openapi.json
